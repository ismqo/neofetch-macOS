#!/bin/bash
# Fake 'sysctl -n <name>...': one value per requested name, in order.
[[ "$1" == -n ]] && shift
status=0
for name; do
    case $name in
        hw.model)                       [[ "$FAKE_ARCH" == intel ]] && echo MacBookPro16,1 || echo Mac16,10 ;;
        kern.boottime)                  echo '{ sec = 1700000000, usec = 0 } Tue Nov 14 22:13:20 2023' ;;
        machdep.cpu.brand_string)       [[ "$FAKE_ARCH" == intel ]] && echo 'Intel(R) Core(TM) i9-9880H CPU @ 2.30GHz' || echo 'Apple M4' ;;
        machdep.cpu.core_count)         echo 8 ;;
        hw.logicalcpu_max)              [[ "$FAKE_ARCH" == intel ]] && echo 16 || echo 10 ;;
        hw.physicalcpu_max)             [[ "$FAKE_ARCH" == intel ]] && echo 8 || echo 10 ;;
        hw.cpufrequency)                echo 2300000000 ;;
        hw.memsize)                     echo 17179869184 ;;
        hw.pagesize)                    echo 16384 ;;
        vm.page_pageable_internal_count) echo 300000 ;;
        vm.page_purgeable_count)        echo 10000 ;;
        sysctl.proc_translated)         [[ "$FAKE_ARCH" == intel ]] && status=1 || echo 0 ;;
        *)                              status=1 ;;
    esac
done
exit $status
