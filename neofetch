# SYSTEM PROBES
#
# Probes wrap macOS interfaces whose results are shared by several fields.
# Results are kept in variables for the lifetime of one invocation only.

cache_uname() {
    IFS=" " read -ra uname <<< "$(uname -srm)"

    kernel_name="${uname[0]}"
    kernel_version="${uname[1]}"
    kernel_machine="${uname[2]}"
}

require_macos() {
    [[ "$kernel_name" == "Darwin" ]] && return

    printf '%s\n' \
        "neofetch: unsupported operating system '${kernel_name:-unknown}'." \
        "neofetch: this version supports macOS only." >&2
    exit 1
}

get_macos_version() {
    # macOS can report incorrect versions unless this is 0.
    # https://github.com/dylanaraps/neofetch/issues/1607
    export SYSTEM_VERSION_COMPAT=0

    local key value line plist=/System/Library/CoreServices/SystemVersion.plist
    local -a sw_vers

    while IFS=: read -r key value; do
        value="${value#"${value%%[![:space:]]*}"}"
        case $key in
            ProductName)    darwin_name="$value" ;;
            ProductVersion) osx_version="$value" ;;
            BuildVersion)   osx_build="$value" ;;
        esac
    done < <(sw_vers 2>/dev/null)

    # Fall back to reading the version file directly if 'sw_vers' fails.
    if [[ -z "$osx_version" && -r "$plist" ]]; then
        IFS=$'\n' read -d "" -ra sw_vers <<< "$(awk -F'<|>' '/key|string/ {print $3}' "$plist")"
        for ((i=0;i<${#sw_vers[@]};i+=2)) {
            line="${sw_vers[i+1]}"
            case ${sw_vers[i]} in
                ProductName)          darwin_name="$line" ;;
                ProductVersion)       osx_version="$line" ;;
                ProductBuildVersion)  osx_build="$line"   ;;
            esac
        }
    fi

    os="${darwin_name:-macOS}"
}

is_apple_silicon() {
    # 'uname -m' reports x86_64 when this shell runs under Rosetta 2;
    # 'sysctl.proc_translated' is 1 for translated processes and missing on Intel.
    [[ "$kernel_machine" == "arm64" ]] && return 0
    [[ -z "$proc_translated" ]] && proc_translated="$(sysctl -n sysctl.proc_translated 2>/dev/null)"
    [[ "$proc_translated" == 1 ]]
}

prefetch_displays() {
    # 'system_profiler' is the slowest probe (~200ms). When the fields to show
    # ($1: their names, e.g. the body of print_info) need it, start it in the
    # background now so it runs while the other fields are detected. Apple
    # Silicon GPUs are read from IOKit instead, so only Resolution needs it.
    local needed nocase

    # Match field names only, not labels such as "GPU Driver".
    shopt -q nocasematch && nocase=1
    shopt -u nocasematch

    if is_field gpu && ! is_apple_silicon && [[ " $1 " =~ [^a-z_]gpu[^a-z_] ]]; then
        needed=1
    elif is_field resolution && [[ " $1 " =~ [^a-z_]resolution[^a-z_] ]] &&
         ! type -p screenresolution >/dev/null; then
        needed=1
    fi

    [[ "$nocase" ]] && shopt -s nocasematch
    [[ "$needed" ]] || return

    # Drop the inherited stderr so an unread probe never holds the caller's pipe.
    exec 9< <(exec 2>/dev/null; exec system_profiler SPDisplaysDataType)
    displays_prefetched=1
}

probe_displays() {
    # One 'system_profiler' call is shared by the GPU and Resolution fields.
    ((displays_probed)) && return
    displays_probed=1

    if ((displays_prefetched)); then
        displays_prefetched=0
        displays_report="$(cat <&9)"
        exec 9<&-
    fi

    # Also covers a prefetch already drained by a subshell, e.g. a config
    # running '$(get_gpu)'.
    [[ "$displays_report" ]] ||
        displays_report="$(system_profiler SPDisplaysDataType 2>/dev/null)"
}

probe_kexts() {
    # Loaded kernel extensions (Hackintosh and NVIDIA web driver checks).
    # Apple silicon Macs can be neither, so the slow probe is skipped there.
    ((kexts_probed)) && return
    kexts_probed=1
    is_apple_silicon && return

    if type -p kmutil &>/dev/null; then
        loaded_kexts="$(kmutil showloaded --list-only 2>/dev/null)"
    else
        loaded_kexts="$(kextstat -l 2>/dev/null)"
    fi
}

# DETECT INFORMATION
#
# Collectors set a variable named after the field (and optionally 'bar_data')
# or call 'add_result' for multi-line fields. They never print.

get_title() {
    user=${USER:-$(id -un || printf %s "${HOME/*\/}")}

    case $title_fqdn in
        on) hostname=$(hostname -f) ;;
        *)  hostname=${HOSTNAME:-$(hostname)} ;;
    esac

    title="${user}@${hostname}"
}

get_distro() {
    [[ $distro ]] && return

    local codename family

    case $osx_version in
        10.0 | 10.0.*)  codename="Mac OS X Cheetah" ;;
        10.1 | 10.1.*)  codename="Mac OS X Puma" ;;
        10.2 | 10.2.*)  codename="Mac OS X Jaguar" ;;
        10.3 | 10.3.*)  codename="Mac OS X Panther" ;;
        10.4*)  codename="Mac OS X Tiger" ;;
        10.5*)  codename="Mac OS X Leopard" ;;
        10.6*)  codename="Mac OS X Snow Leopard" ;;
        10.7*)  codename="Mac OS X Lion" ;;
        10.8*)  codename="OS X Mountain Lion" ;;
        10.9*)  codename="OS X Mavericks" ;;
        10.10*) codename="OS X Yosemite" ;;
        10.11*) codename="OS X El Capitan" ;;
        10.12*) codename="macOS Sierra" ;;
        10.13*) codename="macOS High Sierra" ;;
        10.14*) codename="macOS Mojave" ;;
        10.15*) codename="macOS Catalina" ;;
        10.16*) codename="macOS Big Sur" ;;
        11 | 11.*) codename="macOS Big Sur" ;;
        12 | 12.*) codename="macOS Monterey" ;;
        13 | 13.*) codename="macOS Ventura" ;;
        14 | 14.*) codename="macOS Sonoma" ;;
        15 | 15.*) codename="macOS Sequoia" ;;
        26 | 26.*) codename="macOS Tahoe" ;;
        27 | 27.*) codename="macOS Golden Gate" ;;
        *)         codename="macOS" ;;
    esac

    case $codename in
        "Mac OS X"*) family="Mac OS X" ;;
        "OS X"*)     family="OS X" ;;
        *)           family="macOS" ;;
    esac

    distro="$codename $osx_version $osx_build"

    case $distro_shorthand in
        on)   distro="$codename $osx_version" ;;
        tiny) distro="$family $osx_version" ;;
    esac

    distro="$(trim "$distro")"
    [[ $osx_version ]] || distro="$os"

    # Get OS architecture.
    machine_arch="$kernel_machine"
    [[ "$machine_arch" == "x86_64" ]] && is_apple_silicon && machine_arch="arm64"

    [[ $os_arch == on ]] && \
        distro+=" $machine_arch"

    [[ ${ascii_distro:-auto} == auto ]] && \
        ascii_distro="$(trim "$distro")"
}

get_model() {
    local hw_model
    hw_model="$(sysctl -n hw.model 2>/dev/null)"
    [[ "$hw_model" ]] || { model=; return; }

    probe_kexts
    if [[ "$loaded_kexts" == *FakeSMC* || "$loaded_kexts" == *VirtualSMC* ]]; then
        model="Hackintosh (SMBIOS: $hw_model)"
    else
        model="$hw_model"
    fi
}

get_kernel() {
    case $kernel_shorthand in
        on)  kernel=$kernel_version ;;
        off) kernel="$kernel_name $kernel_version" ;;
    esac
}

get_uptime() {
    local boot now s d h m

    boot=$(sysctl -n kern.boottime 2>/dev/null)
    boot=${boot/\{ sec = }
    boot=${boot/,*}
    [[ "$boot" =~ ^[0-9]+$ ]] || { uptime=; return; }

    # Get current date in seconds.
    now=$(date +%s)
    s=$((now - boot))

    d="$((s / 60 / 60 / 24)) days"
    h="$((s / 60 / 60 % 24)) hours"
    m="$((s / 60 % 60)) minutes"

    # Remove plural if < 2.
    ((${d/ *} == 1)) && d=${d/s}
    ((${h/ *} == 1)) && h=${h/s}
    ((${m/ *} == 1)) && m=${m/s}

    # Hide empty fields.
    ((${d/ *} == 0)) && unset d
    ((${h/ *} == 0)) && unset h
    ((${m/ *} == 0)) && unset m

    uptime=${d:+$d, }${h:+$h, }$m
    uptime=${uptime%', '}
    uptime=${uptime:-$s seconds}

    # Make the output of uptime smaller.
    case $uptime_shorthand in
        on)
            uptime=${uptime/ minutes/ mins}
            uptime=${uptime/ minute/ min}
            uptime=${uptime/ seconds/ secs}
        ;;

        tiny)
            uptime=${uptime/ days/d}
            uptime=${uptime/ day/d}
            uptime=${uptime/ hours/h}
            uptime=${uptime/ hour/h}
            uptime=${uptime/ minutes/m}
            uptime=${uptime/ minute/m}
            uptime=${uptime/ seconds/s}
            uptime=${uptime//,}
        ;;
    esac
}

get_packages() {
    local manager manager_string pkgs_h=0
    local -a managers pkgs
    packages=0

    # has: Check if package manager installed.
    # dir: Count files or dirs in a glob.
    # pac: If packages > 0, log package manager name.
    # tot: Count lines in command output.
    has() { type -p "$1" >/dev/null && manager=$1; }
    # globbing is intentional here
    # shellcheck disable=SC2206
    dir() { pkgs=($@); ((packages+=${#pkgs[@]})); pac "$((${#pkgs[@]}-pkgs_h))"; }
    pac() { (($1 > 0)) && { managers+=("$1 (${manager})"); manager_string+="${manager}, "; }; }
    tot() {
        IFS=$'\n' read -d "" -ra pkgs <<< "$("$@")";
        ((packages+=${#pkgs[@]}));
        pac "$((${#pkgs[@]}-pkgs_h))";
    }

    has port  && pkgs_h=1 tot port installed && ((packages-=1))
    pkgs_h=0

    # shellcheck disable=SC2086
    has brew && {
        shopt -s nullglob
        dir "$(brew_dirs)"
        shopt -u nullglob
    }

    has pkgin && tot pkgin list
    has dpkg  && tot dpkg-query -f '.\n' -W

    has nix-store && {
        nix-user-pkgs() {
            nix-store -qR ~/.nix-profile
            nix-store -qR /etc/profiles/per-user/"$USER"
        }
        manager=nix-system && tot nix-store -qR /run/current-system/sw
        manager=nix-user   && tot nix-user-pkgs
    }

    if ((packages == 0)); then
        unset packages

    elif [[ $package_managers == on ]]; then
        printf -v packages '%s, ' "${managers[@]}"
        packages=${packages%,*}

    elif [[ $package_managers == tiny ]]; then
        packages+=" (${manager_string%,*})"
    fi
}

brew_dirs() {
    # Print the Homebrew Cellar and Caskroom globs.
    # 'brew --cellar' defaults to "$(brew --prefix)/Cellar" and the prefix is
    # the directory brew is installed in, so the standard layout is resolved
    # without starting brew (two brew calls cost ~30 ms). Anything unusual
    # falls back to asking brew.
    local brew_bin prefix cellar caskroom
    brew_bin="$(type -p brew)"
    prefix="${brew_bin%/bin/brew}"

    if [[ -z "$HOMEBREW_CELLAR" && "$prefix" != "$brew_bin" && -d "$prefix/Cellar" ]]; then
        cellar="$prefix/Cellar"
        caskroom="$prefix/Caskroom"
    else
        cellar="$(brew --cellar 2>/dev/null)"
        caskroom="$(brew --caskroom 2>/dev/null)"
    fi

    [[ "$cellar" ]] && printf '%s/* ' "$cellar"
    [[ "$caskroom" ]] && printf '%s/*' "$caskroom"
}

get_shell() {
    case $shell_path in
        on)  shell="$SHELL " ;;
        off) shell="${SHELL##*/} " ;;
    esac

    [[ $shell_version != on ]] && return

    case ${shell_name:=${SHELL##*/}} in
        bash)
            # Ask the login shell: $BASH_VERSION here is the version of the
            # bash running neofetch, which is often not the user's shell.
            local login_version
            login_version=$("$SHELL" -c 'printf %s "$BASH_VERSION"' 2>/dev/null)
            shell+=${login_version/-*}
        ;;

        sh|ash|dash|es) ;;

        *ksh)
            shell+=$("$SHELL" -c "printf %s \"\$KSH_VERSION\"")
            shell=${shell/ * KSH}
            shell=${shell/version}
        ;;

        osh)
            if [[ $OIL_VERSION ]]; then
                shell+=$OIL_VERSION
            else
                shell+=$("$SHELL" -c "printf %s \"\$OIL_VERSION\"")
            fi
        ;;

        tcsh)
            shell+=$("$SHELL" -c "printf %s \$tcsh")
        ;;

        yash)
            shell+=$("$SHELL" --version 2>&1)
            shell=${shell/ $shell_name}
            shell=${shell/ Yet another shell}
            shell=${shell/Copyright*}
        ;;

        nu)
            shell+=$("$SHELL" -c "version | get version")
            shell=${shell/ $shell_name}
        ;;

        *)
            shell+=$("$SHELL" --version 2>&1)
            shell=${shell/ $shell_name}
        ;;
    esac

    # Remove unwanted info.
    shell=${shell/, version}
    shell=${shell/xonsh\//xonsh }
    shell=${shell/options*}
    shell=${shell/\(*\)}
}

get_resolution() {
    resolution=

    if type -p screenresolution >/dev/null; then
        resolution="$(screenresolution get 2>&1 | awk '/Display/ {printf $6 "Hz, "}')"
        resolution="${resolution//x??@/ @ }"
        [[ "$refresh_rate" == "off" ]] && resolution="${resolution// @ [0-9]*Hz}"
        resolution="${resolution%, }"
        return
    fi

    probe_displays

    # Handles both report layouts:
    #   'Resolution: 1920 x 1080 @ 60 Hz' and 'Resolution: 2880 x 1800 Retina'
    #   'Resolution: 5120 x 2880 (5K...)' + 'UI Looks like: 2560 x 1440 @ 60.00Hz'
    local line value px_w px_h ui_w hz retina

    flush_display() {
        [[ "$px_w" ]] || return
        local entry="${px_w}x${px_h}"
        [[ "$retina" || ( "$ui_w" && $((ui_w * 2)) == "$px_w" ) ]] && entry+="@2x"
        hz="${hz%.00}"
        hz="${hz%.0}"
        [[ "$refresh_rate" == "on" && "$hz" && "$hz" != 0 ]] && entry+=" @ ${hz}Hz"
        resolution+="${entry}, "
        px_w= px_h= ui_w= hz= retina=
    }

    while read -r line; do
        case $line in
            "Resolution:"*)
                flush_display
                value="${line#Resolution: }"
                [[ "$value" =~ ^([0-9]+)\ x\ ([0-9]+) ]] || continue
                px_w="${BASH_REMATCH[1]}"
                px_h="${BASH_REMATCH[2]}"
                [[ "$value" =~ @\ ([0-9.]+)\ ?Hz ]] && hz="${BASH_REMATCH[1]}"
                [[ "$value" == *Retina* ]] && retina=1
            ;;

            "UI Looks like:"*)
                value="${line#UI Looks like: }"
                [[ "$value" =~ ^([0-9]+)\ x ]] && ui_w="${BASH_REMATCH[1]}"
                [[ -z "$hz" && "$value" =~ @\ ([0-9.]+)\ ?Hz ]] && hz="${BASH_REMATCH[1]}"
            ;;
        esac
    done <<< "$displays_report"
    flush_display

    resolution="${resolution%, }"
}

