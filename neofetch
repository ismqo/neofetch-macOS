get_macos_disk_usage() {
    # Query the same capacity values macOS uses for its storage display.
    local total avail used
    read -r total avail < <(osascript -l JavaScript -e '
        ObjC.import("Foundation");
        var k = ["NSURLVolumeTotalCapacityKey",
                 "NSURLVolumeAvailableCapacityForImportantUsageKey"];
        var r = $.NSURL.fileURLWithPath("/").resourceValuesForKeysError($(k), null);
        k.map(function (x) { return r.objectForKey(x).js; }).join(" ");
    ' 2>/dev/null)

    [[ $total =~ ^[0-9]+$ && $avail =~ ^[0-9]+$ && $total -gt 0 ]] || return 1

    used=$((total - avail))
    disk_total_gb="$(((total + 500000000) / 1000000000))G"
    disk_used_gb="$(((used + 500000000) / 1000000000))G"
    disk_used_perc=$(((used * 100 + total / 2) / total))
}

parse_df_line() {
    # Split one 'df -P' line into df_fs, df_size, df_used, df_avail, df_perc
    # and df_mount. The filesystem and the mount point may contain spaces, so
    # the line is matched by its shape: three sizes and a 'N%' capacity, then
    # the mount point (everything after it, spaces included). df_perc is
    # always a plain number. Returns 1 when the line has no such shape.
    local line=$1 rest i j n
    local size='^[0-9][0-9.,]*[A-Za-z]*$' perc='^[0-9]+%$'
    local -a f

    IFS=$' \t' read -ra f <<< "$line"
    n=${#f[@]}

    for ((i = 1; i + 4 < n; i++)); do
        [[ ${f[i]} =~ $size && ${f[i+1]} =~ $size && ${f[i+2]} =~ $size &&
           ${f[i+3]} =~ $perc ]] || continue

        df_fs="${f[*]:0:i}"
        df_size=${f[i]}
        df_used=${f[i+1]}
        df_avail=${f[i+2]}
        df_perc=${f[i+3]%\%}

        # The mount point is the rest of the line after the capacity field.
        rest=$line
        for ((j = 0; j < i + 4; j++)); do
            rest="${rest#"${rest%%[![:space:]]*}"}"
            rest="${rest#"${f[j]}"}"
        done
        df_mount="${rest#"${rest%%[![:space:]]*}"}"
        return 0
    done

    return 1
}

get_disk() {
    type -p df &>/dev/null ||
        { err "Disk requires 'df' to function. Install 'df' to get disk info."; return; }

    local disk disk_perc disk_sub i
    local df_fs df_size df_used df_avail df_perc df_mount
    local -a disks disk_targets
    local data_vol=/System/Volumes/Data

    # On APFS, '/' is the sealed read-only system volume and only reports the
    # OS footprint. User data lives on the Data volume, so query it instead.
    disk_targets=("${disk_show[@]:-/}")
    if [[ -d $data_vol ]]; then
        for i in "${!disk_targets[@]}"; do
            [[ ${disk_targets[i]} == / ]] && disk_targets[i]=$data_vol
        done
    fi

    # Create an array called 'disks' where each element is a separate line from
    # df's output. We then unset the first element which removes the column titles.
    # Use decimal units (GB) to match what macOS reports in Finder/Settings.
    IFS=$'\n' read -d "" -ra disks <<< "$(df -P -H "${disk_targets[@]}")"
    unset "disks[0]"

    # Stop here if 'df' fails to print disk info.
    [[ ${disks[*]} ]] || {
        err "Disk: df failed to print the disks, make sure the disk_show array is set properly."
        return
    }

    for disk in "${disks[@]}"; do
        parse_df_line "$disk" || {
            err "Disk: Couldn't read the df line '${disk}'."
            continue
        }
        disk_perc=$df_perc

        disk=${df_used/i}
        disk+=" / "
        disk+=${df_size/i}

        # Present the Data volume as '/' and report usage like macOS does:
        # purgeable space (caches, local snapshots) counts as free, so
        # used = total - available for important usage.
        if [[ "$df_mount" == "$data_vol" ]]; then
            df_mount=/
            get_macos_disk_usage && {
                disk="$disk_used_gb / $disk_total_gb"
                disk_perc=$disk_used_perc
            }
        fi
        [[ $disk_percent != off ]] && disk+=" (${disk_perc}%)"

        case $disk_subtitle in
            name)
                disk_sub=$df_fs
            ;;

            dir)
                disk_sub=${df_mount/*\/}
                disk_sub=${disk_sub:-$df_mount}
            ;;

            none) disk_sub= ;;

            *)
                disk_sub=$df_mount
            ;;
        esac
        disk_sub="${disk_sub//[$'\t\n']/ }"
        disk_sub="${disk_sub//[[:cntrl:]]/}"

        # Append '(disk mount point)' to the subtitle.
        if [[ "$subtitle" ]]; then
            add_result "$subtitle${disk_sub:+ ($disk_sub)}" "$disk" "$disk_perc 100" "$disk_display" "$disk_sub"
        else
            add_result "$disk_sub" "$disk" "$disk_perc 100" "$disk_display" "$disk_sub"
        fi
    done
}

get_battery() {
    local report line state
    local -a fields
    battery=

    report="$(pmset -g batt 2>/dev/null)"

    while IFS= read -r line; do
        [[ "$line" =~ ([0-9]+)% ]] || continue
        [[ "$battery" ]] || battery="${BASH_REMATCH[1]}%"

        [[ "$line" == *";"* && -z "$state" ]] && {
            IFS=$' \t' read -ra fields <<< "$line"
            state="${fields[3]}"
        }
    done <<< "$report"

    [[ "$battery" ]] || return
    [[ "$state" == "charging;" ]] && battery+=" Charging"
    bar_data="${battery/\%*} 100"
}

get_local_ip() {
    local interface

    if [[ "${local_ip_interface[0]}" == "auto" ]]; then
        interface="$(route -n get default 2>/dev/null | awk -F': ' '/interface/ {printf $2; exit}')"
        local_ip="$(ipconfig getifaddr "$interface" 2>/dev/null)"
    else
        for interface in "${local_ip_interface[@]}"; do
            local_ip="$(ipconfig getifaddr "$interface" 2>/dev/null)"
            if [[ -n "$local_ip" ]]; then
                add_result "$interface" "$local_ip"
            else
                err "Local IP: Could not detect local ip for $interface"
            fi
        done
    fi
}

get_users() {
    users="$(who | awk '!seen[$1]++ {printf $1 ", "}')"
    users="${users%\,*}"
}

get_locale() {
    locale="$sys_locale"
}

get_ppid() {
    # Get parent process ID of PID.
    ppid="$(ps -p "${1:-$PPID}" -o ppid=)"
    printf "%s" "$(trim "$ppid")"
}

get_process_name() {
    # Get PID name.
    name="$(ps -p "${1:-$PPID}" -o comm=)"
    printf "%s" "$name"
}

# COLLECTION
#
# 'info' and 'prin' are the configuration API. They record entries; nothing is
# printed until a renderer walks the records.

rec_n=0

record() {
    # kind label value bar_data display_mode plain detail
    # 'plain=value' marks the value as detected text, and 'detail' is the
    # detected part of the label (a mount point); both render as literal text
    # rather than '%b' escapes, while the rest of the label is config text.
    # With 'rec_at' set, fill that reserved slot instead of appending.
    local i=${rec_at:-$rec_n}
    rec_kind[i]="$1"
    rec_label[i]="$2"
    rec_value[i]="$3"
    rec_bar[i]="$4"
    rec_mode[i]="$5"
    rec_plain[i]="$6"
    rec_detail[i]="$7"
    [[ "$rec_at" ]] || ((rec_n++))
}

add_result() {
    # add_result label value bar_data display_mode [detail]: used by
    # collectors that produce several lines (disk, local_ip). The value is
    # detected text; 'detail' names the detected part of the label (a mount
    # point), which the collector has already cleaned of control characters.
    # Tabs and newlines become spaces; other control characters are dropped.
    local value="${2//[$'\t\n']/ }"
    record line "$1" "${value//[[:cntrl:]]/}" "$3" "$4" value "$5"
    prin=1
}

is_field() {
    # 'underline' and 'cols' are layout rows, not detected values.
    case $1 in
        underline | cols) return 0 ;;
    esac

    declare -F "get_$1" >/dev/null
}

info() {
    local name="${2:-$1}" output mode_var

    # Save subtitle value.
    subtitle=
    [[ "$2" ]] && subtitle="$1"

    # Make sure that $prin is unset.
    unset -v prin bar_data

    case $name in
        public_ip | song)
            err "Info: '${name}' has been removed; ignoring '${1}'."
            unset -v subtitle
            return
        ;;
    esac

    if ! is_field "$name"; then
        err "Info: Couldn't detect ${1}."
        unset -v subtitle
        return
    fi

    # Fields that need the background 'system_profiler' are detected after
    # every other field, so waiting for it overlaps with their work. Reserve
    # the slot now to keep the line order; resolve_deferred() fills it.
    if ((displays_prefetched && defer_displays)) && [[ -z "$info_slot" ]] &&
       [[ "$name" == gpu || "$name" == resolution ]]; then
        record deferred "$1" "$2"
        unset -v subtitle
        return
    fi

    # Call the function.
    case $name in
        underline | cols) ;;
        *) "get_${name}" ;;
    esac

    case $name in
        title)     record title "${user//[[:cntrl:]]/}" "${hostname//[[:cntrl:]]/}" ;;
        underline) record underline ;;
        cols)      record cols ;;
    esac

    case $name in
        title | underline | cols) prin=1 ;;
    esac

    # If the get_func function recorded its own lines, stop here.
    [[ "$prin" ]] && { unset -v subtitle; return; }

    # Update the variable. Detected text never carries control characters,
    # so it can't move the cursor, clear the screen or set the window title.
    trim_to output "${!name}"
    output="${output//[[:cntrl:]]/}"
    mode_var="${name}_display"

    if [[ "$2" && "${output// }" ]]; then
        rec_at=$info_slot record line "$1" "$output" "$bar_data" "${!mode_var}" value

    elif [[ "${output// }" ]]; then
        rec_at=$info_slot record line "" "$output" "$bar_data" "${!mode_var}" value

    else
        err "Info: Couldn't detect ${1}."
    fi

    unset -v subtitle
}

check_deferral() {
    # Deferring GPU/Resolution (see info) is only safe when nothing can observe
    # it: the built-in detectors, and with $1 (the body of print_info) a
    # layout made only of 'info' lines, so no later code reads $gpu or
    # $resolution and no override records lines out of order.
    local line first=1
    defer_displays=

    [[ "$(declare -f get_gpu get_resolution)" == "$builtin_display_funcs" ]] || return 0

    if [[ "$1" ]]; then
        while IFS= read -r line; do
            # Skip the 'print_info ()' header and the closing brace.
            [[ "$first" ]] && { first=; continue; }
            [[ "$line" == "}" ]] && continue
            layout_parse_line "$line"
            (($? == 2)) && return 0
        done <<< "$1"
    fi

    defer_displays=1
}

resolve_deferred() {
    # Detect the fields info() deferred and fill their reserved slots. A slot
    # whose field detects nothing stays 'none' and renders nothing.
    local i
    for ((i = 0; i < rec_n; i++)); do
        [[ "${rec_kind[i]}" == deferred ]] || continue
        rec_kind[i]=none
        info_slot=$i info "${rec_label[i]}" ${rec_value[i]:+"${rec_value[i]}"}
    done
}

prin() {
    # If $2 doesn't exist we format $1 as info.
    local label
    trim_to label "$1"
    if [[ "$label" && "$2" ]]; then
        record line "$1" "$2"
    else
        record line "" "${2:-$1}"
    fi

    # Log that prin was used.
    prin=1
}

# RENDERERS

render_json() {
    # Only labelled lines have a key; title, underline, color blocks and
    # unlabelled lines have no JSON representation.
    local i key

    printf '{\n'
    for ((i = 0; i < rec_n; i++)); do
        [[ "${rec_kind[i]}" == line && "${rec_label[i]}" && "${rec_value[i]}" ]] || continue
        json_escape "${rec_label[i]}"
        key="$json_out"
        json_escape "${rec_value[i]}"
        printf '    "%s": "%s",\n' "$key" "$json_out"
    done
    json_escape "$version"
    printf '    "Version": "%s"\n' "$json_out"
    printf '}\n'
}

render_text() {
    local i label value detail

    for ((i = 0; i < rec_n; i++)); do
        case ${rec_kind[i]} in
            title)
                # Detected names: backslashes print as themselves ('\0134').
                local user_out="${rec_label[i]//\\/\\0134}" host_out="${rec_value[i]//\\/\\0134}"
                render_line "" \
                    "${title_color}${bold}${user_out}${at_color}@${title_color}${bold}${host_out}"
            ;;

            underline) render_underline ;;
            cols)      render_cols ;;
            raw)       printf '%b' "${rec_value[i]}" ;;

            line)
                label="${rec_label[i]}"
                value="${rec_value[i]}"

                # Detected text must print as itself, not as '%b' escapes:
                # its backslashes become '\0134', which '%b' prints as '\'.
                # This happens before the bar adds neofetch's own escapes.
                # In the label only the detected part (detail) is escaped;
                # the rest is config text that may use '\e' colors.
                [[ ${rec_plain[i]} == value ]] && value="${value//\\/\\0134}"

                detail="${rec_detail[i]}"
                if [[ "$detail" && "$label" == *"$detail"* ]]; then
                    local before="${label%"$detail"*}"
                    label="${before}${detail//\\/\\0134}${label:${#before}+${#detail}}"
                fi

                [[ "${rec_bar[i]}" ]] && value="$(apply_bar "$value" "${rec_bar[i]}" "${rec_mode[i]}")"
                render_line "$label" "$value"
            ;;
        esac
    done
}

render_line() {
    local string subtitle_color="$subtitle_color" label

    # If $2 doesn't exist we format $1 as info.
    trim_to label "$1"
    if [[ "$label" && "$2" ]]; then
        string="${1}${2:+: $2}"
    else
        string="${2:-$1}"
        subtitle_color="$info_color"
    fi

    trim_to string "${string//$'\e[0m'}"

    # Measure the text as shown: an escaped backslash ('\0134') is one '\'.
    strip_sequences "${string//\\0134/\\}"
    length=$strip
    str_width "$length"
    length="$str_width_out"

    # Format the output.
    string="${string/:/${reset}${colon_color}${separator:=:}${info_color}}"
    string="${subtitle_color}${bold}${string}"

    # Print the info.
    printf '%b\n' "${text_padding:+\e[${text_padding}C}${string//\\n}${reset}"

    # Calculate info height.
    ((++info_height))
}

render_underline() {
    [[ "$underline_enabled" == "on" ]] && {
        printf -v underline "%${length}s"
        printf '%b%b\n' "${text_padding:+\e[${text_padding}C}${underline_color}" \
                        "${underline// /$underline_char}${reset}"
    }

    ((++info_height))
    length=
}

render_cols() {
    local blocks blocks2 cols block_spaces width_spaces n esc=$'\e' nl=$'\n'

    [[ "$color_blocks" == "on" ]] || return

    # Convert the width to space chars.
    printf -v width_spaces "%${block_width}s"

    # Generate the string.
    for ((n = block_range[0]; n <= block_range[1]; n++)); do
        case $n in
            [0-7])
                printf -v blocks  '%b\e[3%bm\e[4%bm%b' "$blocks" "$n" "$n" "$width_spaces"
            ;;

            *)
                printf -v blocks2 '%b\e[38;5;%bm\e[48;5;%bm%b' "$blocks2" "$n" "$n" "$width_spaces"
            ;;
        esac
    done

    # Convert height into spaces.
    printf -v block_spaces "%${block_height}s"

    # Convert the spaces into rows of blocks.
    [[ "$blocks"  ]] && cols+="${block_spaces// /${blocks}${esc}[mnl}"
    [[ "$blocks2" ]] && cols+="${block_spaces// /${blocks2}${esc}[mnl}"

    # Add newlines to the string.
    cols=${cols%%nl}
    cols=${cols//nl/${nl}${esc}[${text_padding}C}

    # Add block height to info height.
    ((info_height+=block_range[1]>7?block_height+2:block_height+1))

    case $col_offset in
        "auto") printf '\n\e[%bC%b\n' "$text_padding" "${cols}" ;;
        *) printf '\n\e[%bC%b\n' "$col_offset" "${cols}" ;;
    esac
}

apply_bar() {
    # value "elapsed total" mode
    local used="${2% *}" total="${2#* }"

    # Bash runs commands found inside arithmetic, so only plain numbers may
    # reach it; anything else is shown without a bar.
    if ! [[ $used =~ ^[0-9]+$ && $total =~ ^[0-9]+$ ]] || ((total == 0)); then
        printf '%s' "$1"
        return
    fi

    case $3 in
        "bar")     bar "$used" "$total" ;;
        "infobar") printf '%s %s' "$1" "$(bar "$used" "$total")" ;;
        "barinfo") printf '%s%s %s' "$(bar "$used" "$total")" "$info_color" "$1" ;;
        "perc")    printf '%s%% %s' "$((used * 100 / total))" "$(bar "$used" "$total")" ;;
        *)         printf '%s' "$1" ;;
    esac
}

bar() {
    local elapsed prog total bar

    # Get the values.
    elapsed="$(($1 * bar_length / $2))"

    # Create the bar with spaces.
    printf -v prog  "%${elapsed}s"
    printf -v total "%$((bar_length - elapsed))s"

    # Set the colors and swap the spaces for $bar_char_.
    bar+="${bar_color_elapsed}${prog// /${bar_char_elapsed}}"
    bar+="${bar_color_total}${total// /${bar_char_total}}"

    # Borders.
    if [[ "$bar_border" == "on" ]]; then
        local border
        color_to border fg
        bar="${border}[${bar}${border}]"
    fi

    printf "%b" "${bar}${info_color}"
}

dynamic_prompt() {
    [[ "$image_backend" == "off" ]] && { printf '\n'; return; }

    # If the ascii art is taller than the info.
    ((lines=lines>info_height?lines-info_height+1:1))

    printf -v nlines "%${lines}s"
    printf "%b" "${nlines// /\\n}"
}

# TERMINAL STATE

terminal_setup() {
    # Hide the cursor and disable line wrap while drawing; always restore them,
    # including on errors and interruption.
    terminal_dirty=1
    trap 'terminal_restore' EXIT
    trap 'terminal_restore; trap - INT; kill -INT $$' INT
    trap 'terminal_restore; trap - TERM; kill -TERM $$' TERM
    trap 'terminal_restore; trap - HUP; kill -HUP $$' HUP
    printf '\e[?25l\e[?7l'
}

terminal_restore() {
    ((terminal_dirty)) || return 0
    terminal_dirty=0
    printf '\e[?25h\e[?7h'
}

# LOGO

draw_logo() {
    # Only ASCII art is drawn: the bundled macOS logo or a custom ASCII file
    # or string. Image backends and the wallpaper lookup were removed.
    case ${image_backend:-ascii} in
        "ascii") print_ascii ;;
        "off") ;;
        *)
            err "Logo: Image backends were removed; '$image_backend' falls back to the ascii logo."
            image_backend="ascii"
            print_ascii
        ;;
    esac

    # Set cursor position next to the logo.
    [[ "$image_backend" != "off" ]] && printf '\e[%sA\e[9999999D' "${lines:-0}"
}

print_ascii() {
    local line ascii_line_width

    case $image_source in
        "auto" | "ascii") ;;

        "wall" | "wallpaper")
            err "Logo: Wallpaper display was removed, using the macOS logo."
        ;;

        *)
            if [[ ! -f "$image_source" ]]; then
                ascii_data="$image_source"
            elif [[ "$image_source" =~ \.(png|jpe?g|svg|gif|heic|tiff?|bmp|webp)$ ]]; then
                err "Logo: Images are no longer displayed ('$image_source'), using the macOS logo."
            else
                ascii_data="$(< "$image_source")"
            fi
        ;;
    esac

    # Calculate size of ascii file in line length / line count.
    while IFS=$'\n' read -r line; do
        line=${line//\\\\/\\}
        str_width "$line"
        ascii_line_width="$str_width_out"
        ((++lines,ascii_line_width>ascii_len)) && ascii_len="$ascii_line_width"
    done <<< "${ascii_data//\$\{??\}}"

    # Fallback if file not found.
    ((lines==1)) && {
        lines=
        ascii_len=
        image_source=auto
        get_distro_ascii
        print_ascii
        return
    }

    # Colors.
    ascii_data="${ascii_data//\$\{c1\}/$c1}"
    ascii_data="${ascii_data//\$\{c2\}/$c2}"
    ascii_data="${ascii_data//\$\{c3\}/$c3}"
    ascii_data="${ascii_data//\$\{c4\}/$c4}"
    ascii_data="${ascii_data//\$\{c5\}/$c5}"
    ascii_data="${ascii_data//\$\{c6\}/$c6}"

    ((text_padding=ascii_len+gap))
    printf '%b\n' "$ascii_data${reset}"
}

# TEXT FORMATTING

get_bold() {
    case $ascii_bold in
        "on")  ascii_bold='\e[1m' ;;
        "off") ascii_bold="" ;;
    esac

    case $bold in
        "on")  bold='\e[1m' ;;
        "off") bold="" ;;
    esac
}

trim() {
    trim_to trim_out "$*"
    printf '%s\n' "$trim_out"
}

trim_to() {
    # trim_to VAR TEXT: store TEXT in VAR with leading and trailing whitespace
    # removed and inner runs collapsed to one space, without a subshell.
    local _var=$1 IFS=$' \t\n'
    set -f
    # shellcheck disable=2086
    set -- $2
    set +f
    printf -v "$_var" '%s' "${*//[[:space:]]/}"
}

json_escape() {
    # Escape a string for use inside a JSON string literal (RFC 8259).
    # Bytes >= 0x80 pass through unchanged so valid UTF-8 stays valid.
    local LC_ALL=C s=$1 i ch hex
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}

    if [[ $s == *[[:cntrl:]]* ]]; then
        s=${s//$'\b'/\\b}
        s=${s//$'\f'/\\f}
        s=${s//$'\n'/\\n}
        s=${s//$'\r'/\\r}
        s=${s//$'\t'/\\t}

        for ((i = 1; i < 32; i++)); do
            printf -v hex '%02x' "$i"
            printf -v ch "\\x$hex"
            [[ $s == *"$ch"* ]] && s=${s//"$ch"/\\u00$hex}
        done
    fi

    json_out=$s
}

str_width() {
    # Width of a string in terminal cells. Bash 3.2 has no wcwidth(), so UTF-8
    # is decoded by hand: East Asian wide and astral-plane (emoji) characters
    # take two cells, combining marks and zero-width characters take none.
    local s="$1" chars bytes i b b1 b2 cp width=0

    LC_ALL="$utf8_locale"
    chars=${#s}
    LC_ALL=C
    bytes=${#s}

    ((chars == bytes)) && { str_width_out=$bytes; return; }

    for ((i = 0; i < bytes; i++)); do
        printf -v b '%d' "'${s:i:1}"
        ((b < 0)) && ((b += 256))

        if ((b < 0x80)); then
            ((width++))

        elif ((b >= 0xF0)); then
            ((width += 2, i += 3))

        elif ((b >= 0xE0)); then
            printf -v b1 '%d' "'${s:i+1:1}"
            printf -v b2 '%d' "'${s:i+2:1}"
            ((cp = ((b & 0x0F) << 12) | (((b1 + 256) & 0x3F) << 6) | ((b2 + 256) & 0x3F)))
            ((i += 2))

            if (((cp >= 0x200B && cp <= 0x200F) || (cp >= 0x20D0 && cp <= 0x20FF) ||
                 (cp >= 0xFE00 && cp <= 0xFE0F))); then
                :
            elif (((cp >= 0x1100 && cp <= 0x115F) || (cp >= 0x2E80 && cp <= 0x303E) ||
                   (cp >= 0x3041 && cp <= 0x33FF) || (cp >= 0x3400 && cp <= 0x4DBF) ||
                   (cp >= 0x4E00 && cp <= 0x9FFF) || (cp >= 0xA000 && cp <= 0xA4CF) ||
                   (cp >= 0xAC00 && cp <= 0xD7A3) || (cp >= 0xF900 && cp <= 0xFAFF) ||
                   (cp >= 0xFE30 && cp <= 0xFE4F) || (cp >= 0xFF00 && cp <= 0xFF60) ||
                   (cp >= 0xFFE0 && cp <= 0xFFE6))); then
                ((width += 2))
            else
                ((width++))
            fi

        elif ((b >= 0xC0)); then
            printf -v b1 '%d' "'${s:i+1:1}"
            ((cp = ((b & 0x1F) << 6) | ((b1 + 256) & 0x3F)))
            ((i += 1))
            ((cp >= 0x300 && cp <= 0x36F)) || ((width++))
        fi
    done

    str_width_out=$width
}

trim_quotes() {
    trim_output="${1//\'}"
    trim_output="${trim_output//\"}"
    printf "%s" "$trim_output"
}

strip_sequences() {
    # Store $1 without color escape sequences in 'strip'.
    strip="${1//$'\e['3[0-9]m}"
    strip="${strip//$'\e['[0-9]m}"
    strip="${strip//\\e\[[0-9]m}"
    strip="${strip//$'\e['38\;5\;[0-9]m}"
    strip="${strip//$'\e['38\;5\;[0-9][0-9]m}"
    strip="${strip//$'\e['38\;5\;[0-9][0-9][0-9]m}"
}

# COLORS

set_colors() {
    color_to c1 "$1"; c1+="${ascii_bold}"
    color_to c2 "$2"; c2+="${ascii_bold}"
    color_to c3 "$3"; c3+="${ascii_bold}"
    color_to c4 "$4"; c4+="${ascii_bold}"
    color_to c5 "$5"; c5+="${ascii_bold}"
    color_to c6 "$6"; c6+="${ascii_bold}"

    [[ "$color_text" != "off" ]] && set_text_colors "$@"
}

set_text_colors() {
    if [[ "${colors[0]}" == "distro" ]]; then
        color_to title_color "$1"
        at_color="$reset"
        underline_color="$reset"
        color_to subtitle_color "$2"
        colon_color="$reset"
        info_color="$reset"

        # If the ascii art uses 8 as a color, make the text the fg.
        ((${1:-1} == 8)) && title_color="$reset"
        ((${2:-7} == 8)) && subtitle_color="$reset"

        # If the second color is white use the first for the subtitle.
        ((${2:-7} == 7)) && color_to subtitle_color "$1"
        ((${1:-1} == 7)) && title_color="$reset"
    else
        color_to title_color "${colors[0]}"
        color_to at_color "${colors[1]}"
        color_to underline_color "${colors[2]}"
        color_to subtitle_color "${colors[3]}"
        color_to colon_color "${colors[4]}"
        color_to info_color "${colors[5]}"
    fi

    # Bar colors.
    if [[ "$bar_color_elapsed" == "distro" ]]; then
        color_to bar_color_elapsed fg
    else
        color_to bar_color_elapsed "$bar_color_elapsed"
    fi

    case ${bar_color_total}${1} in
        distro[736]) color_to bar_color_total "$1" ;;
        distro[0-9]) color_to bar_color_total "$2" ;;
        *)           color_to bar_color_total "$bar_color_total" ;;
    esac
}

color() {
    # Print the escape sequence for color $1 (part of the config API).
    color_to color_out "$1"
    printf '%s' "$color_out"
}

color_to() {
    # color_to VAR N: store color N's escape sequence in VAR, without the
    # subshell '$(color N)' costs.
    local _seq=
    if [[ -z "$no_color" ]]; then
        case $2 in
            [0-6])    printf -v _seq '%b\e[3%sm'   "$reset" "$2" ;;
            7 | "fg") printf -v _seq '\e[37m%b'    "$reset" ;;
            *)        printf -v _seq '\e[38;5;%bm' "$2" ;;
        esac
    fi
    printf -v "$1" '%s' "$_seq"
}

# OTHER

stdout() {
    image_backend="off"
    no_color=1
    unset subtitle_color colon_color info_color underline_color bold title_color at_color \
          text_padding reset color_blocks bar_color_elapsed bar_color_total \
          c1 c2 c3 c4 c5 c6 c7 c8
}

err() {
    local mark
    color_to mark 1
    err+="${mark}[!]${reset} $1
"
}

get_full_path() {
    # This function finds the absolute path from a relative one.
    # For example "Pictures/Wallpapers" --> "/Users/dylan/Pictures/Wallpapers"

    # If the file exists in the current directory, stop here.
    [[ -f "${PWD}/${1}" ]] && { printf '%s\n' "${PWD}/${1}"; return; }

    ! cd "${1%/*}" && {
        err "Error: Directory '${1%/*}' doesn't exist or is inaccessible"
        err "       Check that the directory exists or try another directory."
        exit 1
    }

    local full_dir="${1##*/}"

    # Iterate down a (possible) chain of symlinks.
    while [[ -L "$full_dir" ]]; do
        full_dir="$(readlink "$full_dir")"
        cd "${full_dir%/*}" || exit
        full_dir="${full_dir##*/}"
    done

    # Final directory.
    full_dir="$(pwd -P)/${1/*\/}"

    [[ -e "$full_dir" ]] && printf '%s\n' "$full_dir"
}

get_user_config() {
    # --config /path/to/config.conf
    if [[ -f "$config_file" ]]; then
        source "$config_file"
        err "Config: Sourced user config. (${config_file})"
        return

    elif [[ -f "${XDG_CONFIG_HOME}/neofetch/config.conf" ]]; then
        source "${XDG_CONFIG_HOME}/neofetch/config.conf"
        err "Config: Sourced user config.    (${XDG_CONFIG_HOME}/neofetch/config.conf)"

    elif [[ -f "${XDG_CONFIG_HOME}/neofetch/config" ]]; then
        source "${XDG_CONFIG_HOME}/neofetch/config"
        err "Config: Sourced user config.    (${XDG_CONFIG_HOME}/neofetch/config)"

    elif [[ -z "$no_config" ]]; then
        config_file="${XDG_CONFIG_HOME}/neofetch/config.conf"

        # The config file doesn't exist, create it.
        mkdir -p "${XDG_CONFIG_HOME}/neofetch/"
        printf '%s\n' "$config" > "$config_file"
    fi
}

# LAYOUT EDITOR

# A line that starts a 'print_info' definition, and the only form the editor
# rewrites: the header alone on its line, closed by a '}' in column 0.
layout_def_start='^[[:space:]]*(function[[:space:]]+)?print_info([[:space:]]|[(]|[{]|$)'
layout_def_header='^[[:space:]]*(function[[:space:]]+)?print_info[[:space:]]*([(][)])?[[:space:]]*[{]?[[:space:]]*$'

layout_fail() {
    printf 'neofetch: %s\n' "$@" >&2
    return 1
}

layout_read_block() {
    # Read the body of the 'print_info()' definition on stdin into
    # 'block_lines'. Returns 1 when there is none, 2 when its closing '}' is
    # missing, 3 for an unsupported header, 4 for more than one definition and
    # 5 when the closing '}' shares its line with other code.
    local line state=0 defs=0
    block_lines=()

    while IFS= read -r line || [[ "$line" ]]; do
        if ((state == 1)); then
            if [[ "$line" =~ ^\}[[:space:]]*$ ]]; then
                state=2
            elif [[ "$line" == "}"* ]]; then
                return 5
            else
                block_lines+=("$line")
            fi
            continue
        fi

        [[ "$line" =~ $layout_def_start ]] || continue
        ((++defs > 1)) && return 4
        [[ "$line" =~ $layout_def_header ]] || return 3
        state=1
    done

    ((defs)) || return 1
    ((state == 2)) || return 2
    return 0
}

layout_parse_line() {
    # Set 'parsed_name', 'parsed_label' and 'parsed_shown' from one line of a
    # 'print_info()' body. Returns 1 for lines to skip (blank lines, braces and
    # plain comments) and 2 for code the editor can't represent.
    local line="$1" shown=1
    local labeled='^info[[:space:]]+"([^"$`\\]*)"[[:space:]]+([a-z_]+)$'
    local bare='^info[[:space:]]+([a-z_]+)$'

    line="${line#"${line%%[![:space:]]*}"}"
    if [[ "$line" == "#"* ]]; then
        shown=0
        line="${line#\#}"
        line="${line#"${line%%[![:space:]]*}"}"
    fi
    line="${line%"${line##*[![:space:]]}"}"
    line="${line%;}"
    line="${line%"${line##*[![:space:]]}"}"

    if [[ "$line" =~ $labeled ]]; then
        parsed_label="${BASH_REMATCH[1]}"
        parsed_name="${BASH_REMATCH[2]}"
    elif [[ "$line" =~ $bare ]]; then
        parsed_label=""
        parsed_name="${BASH_REMATCH[1]}"
    elif ((shown)) && [[ "$line" && "$line" != "{" && "$line" != ":" ]]; then
        return 2
    else
        return 1
    fi

    parsed_shown=$shown
    return 0
}

layout_default_index() {
    # Print the index of field $1 in the default layout.
    local i
    for i in "${!def_name[@]}"; do
        [[ "${def_name[i]}" == "$1" ]] && { printf '%s\n' "$i"; return 0; }
    done
    return 1
}

layout_has() {
    local i
    for i in "${!lay_name[@]}"; do
        [[ "${lay_name[i]}" == "$1" ]] && return 0
    done
    return 1
}

layout_add() {
    lay_name+=("$1")
    lay_label+=("$2")
    lay_shown+=("$3")
}

layout_load() {
    # Load the layout of config file $1 into 'lay_name', 'lay_label' and
    # 'lay_shown'. Fields it doesn't list are added, hidden, at the end.
    local line i status
    def_name=() def_label=()
    lay_name=() lay_label=() lay_shown=()

    layout_read_block <<< "$config"
    for line in "${block_lines[@]}"; do
        layout_parse_line "$line" || continue
        def_name+=("$parsed_name")
        def_label+=("$parsed_label")
    done

    layout_read_block < "$1"
    status=$?
    case $status in
        1) layout_read_block <<< "$config" ;;
        2) layout_fail "'print_info()' in $1 has no closing '}' at the start of a line." \
                       "Edit the file by hand instead." ;;
        3) layout_fail "'print_info()' in $1 must start with 'print_info() {' on its own line." \
                       "Edit the file by hand instead." ;;
        4) layout_fail "$1 defines 'print_info()' more than once." \
                       "Edit the file by hand instead." ;;
        5) layout_fail "'print_info()' in $1 must end with '}' on its own line." \
                       "Edit the file by hand instead." ;;
    esac
    ((status > 1)) && return 1

    for line in "${block_lines[@]}"; do
        layout_parse_line "$line"
        status=$?
        if ((status == 2)); then
            layout_fail "'print_info()' in $1 has a line the editor can't represent:" \
                        "  $(trim "$line")" \
                        "Only 'info \"Label\" name' lines and comments are supported." \
                        "Edit the file by hand instead."
            return 1
        fi
        ((status == 1)) && continue

        if ! layout_default_index "$parsed_name" >/dev/null; then
            # A commented-out field that no longer exists is dropped.
            ((parsed_shown)) || continue
            layout_fail "'print_info()' in $1 shows an unknown field: '$parsed_name'." \
                        "Edit the file by hand instead."
            return 1
        fi

        layout_add "$parsed_name" "$parsed_label" "$parsed_shown"
    done

    for i in "${!def_name[@]}"; do
        layout_has "${def_name[i]}" || layout_add "${def_name[i]}" "${def_label[i]}" 0
    done
}

layout_render() {
    # Print the layout as a 'print_info()' definition. Hidden lines stay as
    # comments so they can be shown again later.
    local i line shown=
    printf '%s\n' "print_info() {"
    for i in "${!lay_name[@]}"; do
        line="info ${lay_name[i]}"
        [[ "${lay_label[i]}" ]] && line="info \"${lay_label[i]}\" ${lay_name[i]}"
        ((lay_shown[i])) && shown=1
        ((lay_shown[i])) || line="# $line"
        printf '    %s\n' "$line"
    done

    # A function body needs at least one command.
    [[ "$shown" ]] || printf '    %s\n' ":"
    printf '%s\n' "}"
}

layout_splice() {
    # Print config file $1 with its 'print_info()' definition replaced by the
    # edited layout, or with the layout appended when it has none.
    local line state=0

    while IFS= read -r line || [[ "$line" ]]; do
        case $state in
            0)
                if [[ "$line" =~ $layout_def_start ]]; then
                    layout_render
                    state=1
                    continue
                fi
            ;;

            1)
                [[ "$line" =~ ^\}[[:space:]]*$ ]] && state=2
                continue
            ;;
        esac

        printf '%s\n' "$line"
    done < "$1"

    ((state)) || { printf '\n'; layout_render; }
}

layout_shown_lines() {
    # Print one 'name label' line per shown field, read from a print_info body.
    local line
    for line in "${block_lines[@]}"; do
        layout_parse_line "$line" || continue
        ((parsed_shown)) && printf '%s %s\n' "$parsed_name" "$parsed_label"
    done
}

layout_save() {
    # Rewrite only the 'print_info()' block of the config file. The new file
    # is checked before it replaces the old one, and a backup is kept.
    local file="$layout_file" tmp expected actual line
    local backup="${layout_file}.bak"

    tmp="$(mktemp "${TMPDIR:-/tmp}/neofetch-layout.XXXXXX")" ||
        { layout_msg="Couldn't create a temporary file; nothing was saved."; return 1; }

    # Removed by layout_leave if the save is interrupted.
    layout_tmp=$tmp

    layout_splice "$file" > "$tmp"

    block_lines=()
    while IFS= read -r line; do block_lines+=("$line"); done < <(layout_render)
    expected="$(layout_shown_lines)"

    # Read the layout back from the new file as Bash sees it.
    actual="$(
        print_info() { :; }
        source "$tmp" >/dev/null 2>&1
        declare -f print_info
    )"
    block_lines=()
    while IFS= read -r line; do block_lines+=("$line"); done <<< "$actual"
    actual="$(layout_shown_lines)"

    if ! bash -n "$tmp" 2>/dev/null || [[ "$actual" != "$expected" ]]; then
        rm -f "$tmp"
        layout_msg="The edited config didn't produce the new layout; nothing was saved."
        return 1
    fi

    if ! cp -p "$file" "$backup"; then
        rm -f "$tmp"
        layout_msg="Couldn't write the backup ${backup}; nothing was saved."
        return 1
    fi

    # Write in place to keep the file's permissions and any symlink.
    if ! cat "$tmp" > "$file"; then
        if cat "$backup" > "$file"; then
            layout_msg="Couldn't write ${file}; it was restored from ${backup}."
        else
            layout_msg="Couldn't write ${file}; restore it from ${backup}."
        fi
        rm -f "$tmp"
        return 1
    fi

    rm -f "$tmp"
    layout_tmp=
    return 0
}

layout_swap() {
    # Swap lines $1 and $2. Returns 1 when $2 is out of range.
    local a=$1 b=$2 t
    ((b >= 0 && b < ${#lay_name[@]})) || return 1

    t="${lay_name[a]}";  lay_name[a]="${lay_name[b]}";   lay_name[b]="$t"
    t="${lay_label[a]}"; lay_label[a]="${lay_label[b]}"; lay_label[b]="$t"
    t="${lay_shown[a]}"; lay_shown[a]="${lay_shown[b]}"; lay_shown[b]="$t"
}

layout_rename() {
    local i=$1 input

    case ${lay_name[i]} in
        title | underline | cols)
            layout_msg="The '${lay_name[i]}' line has no label."
            return
        ;;
    esac

    printf '\e[?25h\nNew label for %s (empty keeps "%s"): ' "${lay_name[i]}" "${lay_label[i]}"
    IFS= read -r input
    printf '\e[?25l'

    if [[ -z "$input" ]]; then
        return
    elif [[ "$input" == *[\"\$\`\\]* ]]; then
        layout_msg="Labels can't contain \", \$, \` or \\."
    else
        lay_label[i]="$input"
        layout_changed=1
    fi
}

layout_draw() {
    local i mark label
    printf '\e[H\e[2J'
    printf 'Neofetch layout editor: %s\n\n' "$layout_file"

    for i in "${!lay_name[@]}"; do
        mark="[ ]"
        ((lay_shown[i])) && mark="[x]"

        case ${lay_name[i]} in
            title)     label="user@host" ;;
            underline) label="----------" ;;
            cols)      label="(color blocks)" ;;
            *)         label="${lay_label[i]}" ;;
        esac

        if ((i == layout_cursor)); then
            printf '\e[7m> %s %-18s %-12s\e[m\n' "$mark" "$label" "${lay_name[i]}"
        else
            printf '  %s %-18s %-12s\n' "$mark" "$label" "${lay_name[i]}"
        fi
    done

    printf '\n%s\n%s\n' \
        "up/down, k/j: select   K/J: move line   space: show/hide   enter: rename" \
        "s: save   q: quit"
    [[ "$layout_msg" ]] && printf '\n%s\n' "$layout_msg"
}

layout_key() {
    # Read one key press into 'key'; arrow keys become 'up' and 'down'.
    local rest
    key=
    IFS= read -rsn1 key || return 1

    if [[ "$key" == $'\e' ]]; then
        IFS= read -rsn2 rest
        case $rest in
            "[A" | "OA") key="up" ;;
            "[B" | "OB") key="down" ;;
            *) key="none" ;;
        esac
    fi
    return 0
}

layout_leave() {
    printf '\e[?25h'
    [[ -t 1 ]] && printf '\e[?1049l'

    # An interrupted save leaves its temporary file behind.
    [[ "$layout_tmp" ]] && rm -f "$layout_tmp"
    layout_tmp=
}

customize_layout() {
    # 'neofetch --customize': choose, order and label the info lines, then
    # save them to the 'print_info()' block of the config file.
    local key layout_cursor=0 layout_changed= layout_msg= quit_armed= saved=

    # Field names are lowercase; match them exactly.
    shopt -u nocasematch

    if [[ "$no_config" == on || "$config_off" == on ]]; then
        layout_fail "--customize edits the config file; it can't be used with --no_config or '--config none'."
        return 1
    elif [[ -f "$config_file" ]]; then
        layout_file="$config_file"
    elif [[ -f "${XDG_CONFIG_HOME}/neofetch/config.conf" ]]; then
        layout_file="${XDG_CONFIG_HOME}/neofetch/config.conf"
    elif [[ -f "${XDG_CONFIG_HOME}/neofetch/config" ]]; then
        layout_file="${XDG_CONFIG_HOME}/neofetch/config"
    else
        layout_fail "No config file to edit."
        return 1
    fi

    layout_load "$layout_file" || return 1

    # Restore the screen and remove an unfinished save on any exit.
    trap 'layout_leave' EXIT
    trap 'layout_leave; trap - INT; kill -INT $$' INT
    trap 'layout_leave; trap - TERM; kill -TERM $$' TERM
    trap 'layout_leave; trap - HUP; kill -HUP $$' HUP
    [[ -t 1 ]] && printf '\e[?1049h'
    printf '\e[?25l'

    while :; do
        layout_draw
        layout_key || break

        [[ "$key" == q ]] || quit_armed=
        layout_msg=

        case $key in
            up | k)   ((layout_cursor > 0)) && ((layout_cursor--)) ;;
            down | j) ((layout_cursor < ${#lay_name[@]} - 1)) && ((layout_cursor++)) ;;

            K)
                layout_swap "$layout_cursor" "$((layout_cursor - 1))" &&
                    { ((layout_cursor--)); layout_changed=1; }
            ;;

            J)
                layout_swap "$layout_cursor" "$((layout_cursor + 1))" &&
                    { ((layout_cursor++)); layout_changed=1; }
            ;;

            " ")
                lay_shown[layout_cursor]=$((1 - lay_shown[layout_cursor]))
                layout_changed=1
            ;;

            "") layout_rename "$layout_cursor" ;;

            s)
                layout_save && { saved=1; break; }
            ;;

            q)
                [[ -z "$layout_changed" || "$quit_armed" ]] && break
                quit_armed=1
                layout_msg="Unsaved changes: press q again to discard them, or s to save."
            ;;
        esac
    done

    layout_leave
    trap - EXIT INT TERM HUP

    if [[ "$saved" ]]; then
        printf '%s\n' "Saved the layout to ${layout_file} (backup: ${layout_file}.bak)."
    else
        printf '%s\n' "No changes were saved."
    fi
}

