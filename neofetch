                                All values are strings. Unlabelled lines and fields
                                that could not be detected are left out.
    --help                      Print this text and exit
    --version                   Show neofetch version
    -v                          Display error messages.
    -vv                         Display a verbose log for error reporting.

DEVELOPER:
    --gen-man                   Generate a manpage for Neofetch in your PWD. (Requires GNU help2man)


Report bugs to https://github.com/dylanaraps/neofetch/issues

"
exit 1
}

reject_removed_options() {
    # Public IP lookup, song information and image display were removed. Fail
    # loudly instead of silently ignoring scripts that still ask for them.
    local arg prev
    for arg; do
        if [[ "$prev" == "--backend" && "$arg" != "ascii" && "$arg" != "off" ]]; then
            printf '%s\n' \
                "neofetch: '--backend $arg' is no longer supported: image display has been removed." \
                "neofetch: use '--backend ascii' or '--backend off'." >&2
            exit 1
        fi
        prev="$arg"

        case $arg in
            "--ip_host" | "--ip_timeout" | "public_ip")
                printf '%s\n' \
                    "neofetch: '$arg' is no longer supported: public IP lookup has been removed." \
                    "neofetch: use 'local_ip' / '--ip_interface' for local addresses." >&2
                exit 1
            ;;

            "--caca" | "--catimg" | "--chafa" | "--jp2a" | "--iterm2" | "--kitty" | "--pot" |\
            "--pixterm" | "--sixel" | "--termpix" | "--viu" | "--w3m" | "--ueberzug" |\
            "--tycat" | "--image_size" | "--size" | "--catimg_size" | "--crop_mode" |\
            "--crop_offset" | "--xoffset" | "--yoffset" | "--bg_color" | "--background_color" |\
            "--loop" | "--clean")
                printf '%s\n' \
                    "neofetch: '$arg' is no longer supported: image display has been removed." \
                    "neofetch: only the ascii macOS logo (or a custom ascii file) is shown." >&2
                exit 1
            ;;

            "--song_format" | "--song_shorthand" | "--music_player" | "song")
                printf '%s\n' \
                    "neofetch: '$arg' is no longer supported: song information has been removed." >&2
                exit 1
            ;;
        esac
    done
}

get_args() {
    reject_removed_options "$@"

    # Check the commandline flags early for '--config'.
    [[ "$*" != *--config* && "$*" != *--no_config* ]] && get_user_config

    while [[ "$1" ]]; do
        case $1 in
            # Info
            "--title_fqdn") title_fqdn="$2" ;;
            "--package_managers") package_managers="$2" ;;
            "--os_arch") os_arch="$2" ;;
            "--cpu_cores") cpu_cores="$2" ;;
            "--cpu_speed") cpu_speed="$2" ;;
            "--distro_shorthand") distro_shorthand="$2" ;;
            "--kernel_shorthand") kernel_shorthand="$2" ;;
            "--uptime_shorthand") uptime_shorthand="$2" ;;
            "--cpu_brand") cpu_brand="$2" ;;
            "--gpu_brand") gpu_brand="$2" ;;
            "--refresh_rate") refresh_rate="$2" ;;
            "--shell_path") shell_path="$2" ;;
            "--shell_version") shell_version="$2" ;;
            "--ip_interface")
                unset local_ip_interface
                for arg in "$@"; do
                    case "$arg" in
                        "--ip_interface") ;;
                        "-"*) break ;;
                        *) local_ip_interface+=("$arg") ;;
                    esac
                done
            ;;

            "--memory_percent") memory_percent="$2" ;;
            "--memory_unit") memory_unit="$2" ;;

            "--disk_subtitle") disk_subtitle="$2" ;;
            "--disk_percent")  disk_percent="$2" ;;
            "--disk_show")
                unset disk_show
                for arg in "$@"; do
                    case $arg in
                        "--disk_show") ;;
                        "-"*) break ;;
                        *) disk_show+=("$arg") ;;
                    esac
                done
            ;;

            "--disable")
                for func in "$@"; do
                    case $func in
                        "--disable") continue ;;
                        "-"*) break ;;
                        *)
                            ((bash_version >= 4)) && func="${func,,}"
                            unset -f "get_$func"
                        ;;
                    esac
                done
            ;;

            # Text Colors
            "--colors")
                unset colors
                for arg in "$2" "$3" "$4" "$5" "$6" "$7"; do
                    case $arg in
                        "-"*) break ;;
                        *) colors+=("$arg") ;;
                    esac
                done
                colors+=(7 7 7 7 7 7)
            ;;

            # Text Formatting
            "--underline") underline_enabled="$2" ;;
            "--underline_char") underline_char="$2" ;;
            "--bold") bold="$2" ;;
            "--separator") separator="$2" ;;

            # Color Blocks
            "--color_blocks") color_blocks="$2" ;;
            "--block_range") block_range=("$2" "$3") ;;
            "--block_width") block_width="$2" ;;
            "--block_height") block_height="$2" ;;
            "--col_offset") col_offset="$2" ;;

            # Bars
            "--bar_char")
                bar_char_elapsed="$2"
                bar_char_total="$3"
            ;;

            "--bar_border") bar_border="$2" ;;
            "--bar_length") bar_length="$2" ;;
            "--bar_colors")
                bar_color_elapsed="$2"
                bar_color_total="$3"
            ;;

            "--memory_display") memory_display="$2" ;;
            "--battery_display") battery_display="$2" ;;
            "--disk_display") disk_display="$2" ;;

            # Logo
            "--backend") image_backend="$2" ;;
            "--source") image_source="$2" ;;
            "--ascii" | "--off")
                image_backend="${1/--}"
                case $2 in
                    "-"* | "") ;;
                    *) image_source="$2" ;;
                esac
            ;;

            "--gap") gap="$2" ;;

            "--ascii_colors")
                unset ascii_colors
                for arg in "$2" "$3" "$4" "$5" "$6" "$7"; do
                    case $arg in
                        "-"*) break ;;
                        *) ascii_colors+=("$arg")
                    esac
                done
                ascii_colors+=(7 7 7 7 7 7)
            ;;

            "--ascii_distro")
                image_backend="ascii"
                ascii_distro="$2"
            ;;

            "--ascii_bold") ascii_bold="$2" ;;
            "--logo" | "-L")
                image_backend="ascii"
                print_info() { record raw "" '\n'; }
            ;;

            # Other
            "--config")
                case $2 in
                    "none" | "off" | "") config_off="on" ;;
                    *)
                        config_file="$(get_full_path "$2")"
                        get_user_config
                    ;;
                esac
            ;;
            "--no_config") no_config="on" ;;
            "--customize") customize="on" ;;
            "--stdout") stdout="on" ;;
            "-v") verbose="on" ;;
            "--print_config") printf '%s\n' "$config"; exit ;;
            "-vv") set -x; verbose="on" ;;
            "--help") usage ;;
            "--version")
                printf '%s\n' "Neofetch $version"
                exit 1
            ;;
            "--gen-man")
                help2man -n "A fast, highly customizable system info script for macOS" \
                          -N ./neofetch -o neofetch.1
                exit 1
            ;;

            "--json") json="on" ;;
        esac

        shift
    done
}

get_simple() {
    # 'neofetch uptime memory' prints just those fields, without art or colors.
    local -a fields
    while [[ "$1" ]]; do
        is_field "$1" && fields+=("$1")
        shift
    done

    ((${#fields[@]})) || return 1

    prefetch_displays "${fields[*]}"
    check_deferral
    get_distro
    stdout
    for field in "${fields[@]}"; do
        info "$field" "$field"
    done
    resolve_deferred
}

get_distro_ascii() {
    # Only the macOS artwork is bundled. Any other name falls back to the
    # macOS logo, as neofetch always did for unknown names on Darwin.
    case $(trim "$ascii_distro") in
        "mac"*"_small")
            set_colors 2 3 1 5 4
            read -rd '' ascii_data <<'EOF'
${c1}       .:'
    _ :'_
${c2} .'`_`-'_``.
:________.-'
${c3}:_______:
:_______:
${c4} :_______`-;
${c5}  `._.-._.'
EOF
        ;;

        "mac"* | "Darwin")
            set_colors 2 3 1 1 5 4
            read -rd '' ascii_data <<'EOF'
${c1}                    c.'
                 ,xNMM.
               .OMMMMo
               lMM"
     .;loddo:.  .olloddol;.
   cKMMMMMMMMMMNWMMMMMMMMMM0:
${c2} .KMMMMMMMMMMMMMMMMMMMMMMMWd.
 XMMMMMMMMMMMMMMMMMMMMMMMX.
${c3};MMMMMMMMMMMMMMMMMMMMMMMM:
:MMMMMMMMMMMMMMMMMMMMMMMM:
${c4}.MMMMMMMMMMMMMMMMMMMMMMMMX.
 kMMMMMMMMMMMMMMMMMMMMMMMMWd.
 ${c5}'XMMMMMMMMMMMMMMMMMMMMMMMMMMk
  'XMMMMMMMMMMMMMMMMMMMMMMMMK.
    ${c6}kMMMMMMMMMMMMMMMMMMMMMMd
     ;KMMMMMMMWXXWMMMMMMMk.
       "cooc*"    "*coo'"
EOF
        ;;

        *)
            err "Ascii: No bundled art named '$ascii_distro', using the macOS logo."
            set_colors 2 3 1 1 5 4
            read -rd '' ascii_data <<'EOF'
${c1}                    c.'
                 ,xNMM.
               .OMMMMo
               lMMM"
     .;loddo:.  .olloddol;.
   cKMMMMMMMMMMNWMMMMMMMMMM0:
${c2} .KMMMMMMMMMMMMMMMMMMMMMMMWd.
 XMMMMMMMMMMMMMMMMMMMMMMMX.
${c3};MMMMMMMMMMMMMMMMMMMMMMMM:
:MMMMMMMMMMMMMMMMMMMMMMMM:
${c4}.MMMMMMMMMMMMMMMMMMMMMMMMX.
 kMMMMMMMMMMMMMMMMMMMMMMMMWd.
 ${c5}'XMMMMMMMMMMMMMMMMMMMMMMMMMMk
  'XMMMMMMMMMMMMMMMMMMMMMMMMK.
    ${c6}kMMMMMMMMMMMMMMMMMMMMMMd
     ;KMMMMMMMWXXWMMMMMMMk.
       "cooc*"    "*coo'"
EOF
        ;;
    esac

    # Overwrite distro colors if '$ascii_colors' doesn't
    # equal 'distro'.
    [[ ${ascii_colors[0]} != distro ]] && {
        color_text=off
        set_colors "${ascii_colors[@]}"
    }
}

main() {
    cache_uname
    require_macos
    get_macos_version

    # Remember the built-in display detectors before any config can override
    # them (see check_deferral).
    builtin_display_funcs="$(declare -f get_gpu get_resolution)"

    # Load default config.
    eval "$config"

    get_args "$@"
    if [[ $customize == on ]]; then
        customize_layout
        return
    fi
    [[ $verbose != on ]] && exec 2>/dev/null

    # Collect: run the user's print_info() to record every field.
    if [[ $json == on ]]; then
        stdout
        print_info_body="$(declare -f print_info)"
        prefetch_displays "$print_info_body"
        check_deferral "$print_info_body"
        print_info 2>/dev/null
        resolve_deferred 2>/dev/null
        render_json
        return 0
    fi

    if get_simple "$@"; then
        render_text
        return 0
    fi

    print_info_body="$(declare -f print_info)"
    prefetch_displays "$print_info_body"
    check_deferral "$print_info_body"
    get_distro
    get_bold
    get_distro_ascii
    [[ $stdout == on ]] && stdout

    print_info
    resolve_deferred

    # Render: draw the logo, then the recorded lines next to it.
    [[ $stdout != on ]] && terminal_setup

    draw_logo
    render_text
    dynamic_prompt

    # Add neofetch info to verbose output.
    err "Neofetch command: $0 $*"
    err "Neofetch version: $version"

    [[ $verbose == on ]] && printf '%b\033[m' "$err" >&2

    return 0
}

main "$@"
