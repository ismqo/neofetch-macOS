get_term() {
    # If function was run, stop here.
    ((term_run == 1)) && return

    detect_terminal

    case $term_id in
        ghostty)
            term="Ghostty"
            [[ "$term_mux" == tmux ]] && term+=" (tmux)"
        ;;

        *)
            case $TERM_PROGRAM in
                "iTerm.app")    term="iTerm2" ;;
                "Terminal.app") term="Apple Terminal" ;;
                "Hyper")        term="HyperTerm" ;;
                *)              term="${TERM_PROGRAM/\.app}" ;;
            esac
        ;;
    esac

    [[ "$SSH_CONNECTION" ]] && term="$SSH_TTY"

    # Check $PPID for terminal emulator.
    local parent name
    while [[ -z "$term" ]]; do
        parent="$(get_ppid "$parent")"
        [[ -z "$parent" ]] && break
        name="$(get_process_name "$parent")"

        case ${name// } in
            "${SHELL/*\/}"|*"sh"|"screen"|"su"*|"newgrp") ;;

            "login"*|*"Login"*|"init"|"(init)")
                term="$(tty)"
            ;;

            "ruby"|"1"|"tmux"*|"sshd"*|"python"*|\
            "USER"*"PID"*|"launchd"*)
                break
            ;;

            *"nvim")           term="Neovim Terminal" ;;
            *"NeoVimServer"*)  term="VimR Terminal" ;;
            *"ghostty")        term="Ghostty" ;;

            *)
                term="${name##*/}"

                # Fix wrapper names in Nix.
                [[ $term == .*-wrapped ]] && {
                   term="${term#.}"
                   term="${term%-wrapped}"
                }
            ;;
        esac
    done

    # Log that the function was run.
    term_run=1
}

detect_terminal() {
    # Identify the terminal emulator the output is drawn by.
    #   term_id:  normalized emulator id ('ghostty' or '' when not special-cased)
    #   term_mux: 'tmux' when running inside tmux
    #
    # Ghostty sets TERM_PROGRAM=ghostty and TERM=xterm-ghostty, but users may
    # override TERM (term = xterm-256color), so TERM alone is not trusted.
    # Inside tmux, TERM_PROGRAM is 'tmux' and the environment may be stale, so
    # the attached client's terminal is asked for instead: tmux records each
    # client's XTVERSION reply (client_termtype) and TERM (client_termname).
    ((terminal_detected)) && return
    terminal_detected=1
    term_id=
    term_mux=

    if [[ "$TMUX" ]]; then
        term_mux=tmux
        local client
        client="$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} \
                  '#{client_termtype}|#{client_termname}' 2>/dev/null)"
        [[ "$client" == *ghostty* ]] && term_id=ghostty
        return
    fi

    case $TERM_PROGRAM in
        ghostty) term_id=ghostty ;;
        "")
            if [[ "$TERM" == xterm-ghostty ]]; then
                term_id=ghostty
            elif [[ "$GHOSTTY_RESOURCES_DIR" && "$TERM" != screen* && "$TERM" != tmux* ]]; then
                term_id=ghostty
            fi
        ;;
    esac
}

ghostty_binary() {
    local bin
    for bin in "${GHOSTTY_BIN_DIR:+$GHOSTTY_BIN_DIR/ghostty}" "$(type -p ghostty)" \
               /Applications/Ghostty.app/Contents/MacOS/ghostty; do
        [[ -x "$bin" ]] && { printf '%s\n' "$bin"; return 0; }
    done
    return 1
}

get_term_font() {
    ((term_run != 1)) && get_term

    case $term_id in
        ghostty)
            # '+show-config' prints the effective configuration; an empty
            # 'font-family' means Ghostty's embedded default, JetBrains Mono.
            local bin key value family size
            bin="$(ghostty_binary)" || return

            while IFS='=' read -r key value; do
                key="${key%"${key##*[![:space:]]}"}"
                value="${value#"${value%%[![:space:]]*}"}"
                case $key in
                    font-family) [[ -z "$family" ]] && family="$value" ;;
                    font-size)   size="$value" ;;
                esac
            done < <("$bin" +show-config 2>/dev/null)

            family="$(trim_quotes "$family")"
            term_font="${family:-JetBrains Mono}${size:+ $size}"
            return
        ;;
    esac

    case $term in
        "alacritty"*)
            shopt -s nullglob
            confs=({$XDG_CONFIG_HOME,$HOME}/{alacritty,}/{.,}alacritty.ym?)
            shopt -u nullglob

            [[ -f "${confs[0]}" ]] || return

            term_font="$(awk '/normal:/ {while (!/family:/ || /#/)
                         {if (!getline) {exit}} print; exit}' "${confs[0]}")"
            term_font="${term_font/*family:}"
            term_font="${term_font/$'\n'*}"
            term_font="${term_font/\#*}"
            term_font="${term_font//\"}"
        ;;

        "Apple_Terminal")
            term_font="$(osascript <<END
                         tell application "Terminal" to font name of window frontmost
END
)"
        ;;

        "iTerm2")
            # Unfortunately the profile name is not unique, but it seems to be the only thing
            # that identifies an active profile. There is the "id of current session of current win-
            # dow" though, but that does not match to a guid in the plist.
            # So, be warned, collisions may occur!
            # See: https://groups.google.com/forum/#!topic/iterm2-discuss/0tO3xZ4Zlwg
            local current_profile_name profiles_count profile_name diff_font

            current_profile_name="$(osascript <<END
                                    tell application "iTerm2" to profile name \
                                    of current session of current window
END
)"

            # Warning: Dynamic profiles are not taken into account here!
            # https://www.iterm2.com/documentation-dynamic-profiles.html
            font_file="${HOME}/Library/Preferences/com.googlecode.iterm2.plist"

            # Count Guids in "New Bookmarks"; they should be unique
            profiles_count="$(PlistBuddy -c "Print ':New Bookmarks:'" "$font_file" | \
                              grep -w -c "Guid")"

            for ((i=0; i<profiles_count; i++)); do
                profile_name="$(PlistBuddy -c "Print ':New Bookmarks:${i}:Name:'" "$font_file")"

                if [[ "$profile_name" == "$current_profile_name" ]]; then
                    # "Normal Font"
                    term_font="$(PlistBuddy -c "Print ':New Bookmarks:${i}:Normal Font:'" \
                                 "$font_file")"

                    # Font for non-ascii characters
                    # Only check for a different non-ascii font, if the user checked
                    # the "use a different font for non-ascii text" switch.
                    diff_font="$(PlistBuddy -c "Print ':New Bookmarks:${i}:Use Non-ASCII Font:'" \
                                 "$font_file")"

                    if [[ "$diff_font" == "true" ]]; then
                        non_ascii="$(PlistBuddy -c "Print ':New Bookmarks:${i}:Non Ascii Font:'" \
                                     "$font_file")"

                        [[ "$term_font" != "$non_ascii" ]] && \
                            term_font="$term_font (normal) / $non_ascii (non-ascii)"
                    fi
                fi
            done
        ;;

        "Hyper"*)
            term_font="$(awk -F':|,' '/fontFamily/ {print $2; exit}' "${HOME}/.hyper.js")"
            term_font="$(trim_quotes "$term_font")"
        ;;

        "kitty"*)
            term_font="from kitty.cli import *; o = create_default_opts(); \
                       print(f'{o.font_family} {o.font_size}')"
            term_font="$(kitty +runpy ''"$term_font"'')"
        ;;
    esac
}

get_cpu() {
    local cores

    cpu="$(sysctl -n machdep.cpu.brand_string 2>/dev/null)"
    [[ "$cpu" ]] || return

    # Get CPU cores.
    case $cpu_cores in
        "logical" | "on") cores="$(sysctl -n hw.logicalcpu_max 2>/dev/null)" ;;
        "physical")       cores="$(sysctl -n hw.physicalcpu_max 2>/dev/null)" ;;
    esac

    # Remove un-needed patterns from cpu output.
    cpu="${cpu//(TM)}"
    cpu="${cpu//(tm)}"
    cpu="${cpu//(R)}"
    cpu="${cpu//(r)}"
    cpu="${cpu//CPU}"
    cpu="${cpu//Processor}"
    cpu="${cpu//Dual-Core}"
    cpu="${cpu//Quad-Core}"
    cpu="${cpu//Six-Core}"
    cpu="${cpu//Eight-Core}"
    cpu="${cpu//[1-9][0-9]-Core}"
    cpu="${cpu//[0-9]-Core}"
    cpu="${cpu//Core / }"
    cpu="${cpu//Core2/Core 2}"

    # Trim spaces from core output
    cores="${cores//[[:space:]]}"

    # Remove CPU brand from the output.
    if [[ "$cpu_brand" == "off" ]]; then
        cpu="${cpu/Intel }"
        cpu="${cpu/Core? Duo }"
    fi

    # Intel brand strings carry their speed ("... @ 2.30GHz").
    [[ "$cpu_speed" == "off" ]] && cpu="${cpu/ @*}"

    # Add CPU cores to the output. Apple silicon names have no '@' part.
    if [[ "$cpu_cores" != "off" && "$cores" ]]; then
        if [[ "$cpu" == *@* ]]; then
            cpu="${cpu/@/(${cores}) @}"
        else
            cpu="$(trim "$cpu") ($cores)"
        fi
    fi
}

get_gpu() {
    local line
    gpu=

    # Apple Silicon has one integrated GPU, which IOKit names without the slow
    # 'system_profiler' call.
    if is_apple_silicon; then
        while IFS= read -r line; do
            case $line in
                *'"model" = "'*)
                    line="${line#*\"model\" = \"}"
                    gpu="${line%\"}"
                    break
                ;;
            esac
        done < <(ioreg -rc AGXAccelerator -d1 2>/dev/null)
    fi

    if [[ -z "$gpu" ]]; then
        probe_displays

        while IFS= read -r line; do
            case $line in
                *"Chipset Model:"*) gpu+="${line#*: }, " ;;
            esac
        done <<< "$displays_report"

        gpu="${gpu%, }"
    fi

    if [[ "$gpu_brand" == "off" ]]; then
        gpu="${gpu//AMD }"
        gpu="${gpu//NVIDIA }"
        gpu="${gpu//Intel }"
    fi
}

get_memory() {
    local hw_pagesize mem_total mem_used mem_perc mem_label pages_app pages_wired
    local pages_compressed line pageable purgeable mem_bytes

    hw_pagesize="$(sysctl -n hw.pagesize 2>/dev/null)"
    mem_bytes="$(sysctl -n hw.memsize 2>/dev/null)"
    pageable="$(sysctl -n vm.page_pageable_internal_count 2>/dev/null)"
    purgeable="$(sysctl -n vm.page_purgeable_count 2>/dev/null)"

    [[ "$hw_pagesize" =~ ^[0-9]+$ && "$mem_bytes" =~ ^[0-9]+$ ]] || { memory=; return; }

    # One vm_stat call provides both the wired and compressed page counts.
    while IFS= read -r line; do
        case $line in
            "Pages wired down:"*)             pages_wired="${line##* }" ;;
            "Pages occupied by compressor:"*) pages_compressed="${line##* }" ;;
        esac
    done < <(vm_stat 2>/dev/null)

    pages_wired="${pages_wired//[!0-9]}"
    pages_compressed="${pages_compressed//[!0-9]}"
    pages_app="$((${pageable:-0} - ${purgeable:-0}))"

    mem_total="$((mem_bytes / 1024 / 1024))"
    mem_used="$(((pages_app + ${pages_wired:-0} + ${pages_compressed:-0}) * hw_pagesize / 1024 / 1024))"

    # Bars are always computed from whole MiB values.
    bar_data="$mem_used $mem_total"

    [[ "$memory_percent" == "on" ]] && ((mem_perc=mem_used * 100 / mem_total))

    case $memory_unit in
        gib)
            mem_used=$(awk '{printf "%.2f", $1 / $2}' <<< "$mem_used 1024")
            mem_total=$(awk '{printf "%.2f", $1 / $2}' <<< "$mem_total 1024")
            mem_label=GiB
        ;;

        kib)
            mem_used=$((mem_used * 1024))
            mem_total=$((mem_total * 1024))
            mem_label=KiB
        ;;
    esac

    memory="${mem_used}${mem_label:-MiB} / ${mem_total}${mem_label:-MiB} ${mem_perc:+(${mem_perc}%)}"
}

