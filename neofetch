get_wm_theme() {
    ((wm_run != 1)) && get_wm

    local style accent

    # 'defaults' goes through cfprefsd, so it sees unsaved preference changes
    # that reading the plist file directly would miss.
    style="$(defaults read -g AppleInterfaceStyle 2>/dev/null)"
    accent="$(defaults read -g AppleAccentColor 2>/dev/null)"

    [[ "$style" ]] || style=Light

    case $accent in
        -1) accent=Graphite ;;
        0)  accent=Red ;;
        1)  accent=Orange ;;
        2)  accent=Yellow ;;
        3)  accent=Green ;;
        5)  accent=Purple ;;
        6)  accent=Pink ;;
